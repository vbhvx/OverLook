# OverLook configuration. Every key is optional; defaults suit local development.
# backend/app/config.py is the authoritative list.

# --- Runtime ------------------------------------------------------------------
ENVIRONMENT=development            # development | test | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=console                 # json in containers
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Storage ------------------------------------------------------------------
# memory:// runs fully in-process (no database). A PostGIS URL enables durable
# storage, the standalone worker, leader election and cross-process live events.
DATABASE_URL=memory://
# DATABASE_URL=postgresql+asyncpg://overlook:overlook@localhost:5432/overlook

# Used by docker compose for the bundled PostGIS container.
POSTGRES_DB=overlook
POSTGRES_USER=overlook
POSTGRES_PASSWORD=overlook

# --- Ingestion ----------------------------------------------------------------
ENABLE_BACKGROUND_SYNC=true        # run the scheduler inside the API process
SEED_FIXTURES=true                 # load labelled simulated fixtures on start
SIGNAL_RETENTION_HOURS=72
PROVIDER_TIMEOUT_SECONDS=10
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_SECONDS=300
MANUAL_SYNC_COOLDOWN_SECONDS=60

# Optional OpenSky credentials (raise the anonymous rate limit).
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# --- API protection -----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=100
TRUSTED_PROXY_COUNT=1              # reverse proxies in front of the API
MAX_QUERY_RESULTS=1000
MAX_SSE_CLIENTS=500

# --- Observability profile ----------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin
