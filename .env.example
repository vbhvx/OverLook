# OverLook Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL with PostGIS or SQLite fallback)
# For Docker / Local PostgreSQL with PostGIS:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/overlook
# For local zero-dependency development fallback:
# DATABASE_URL=sqlite+aiosqlite:///./overlook.db

# Live Provider Configurations (Optional credentials - defaults use open endpoints)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Cache / Rate Limiting
PROVIDER_CACHE_TTL_SECONDS=120
PROVIDER_TIMEOUT_SECONDS=10.0
ENABLE_BACKGROUND_SYNC=true
DEFAULT_SYNC_INTERVAL_SECONDS=300

# Geographic Query Limits
MAX_BBOX_DIAGONAL_KM=20000
MAX_QUERY_RESULTS=1000
DEFAULT_QUERY_RESULTS=250

